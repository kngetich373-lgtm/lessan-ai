#!/bin/bash
# ============================================================
#  postinst — Lessan AI .deb maintainer script
#  Runs as root after installation. Idempotent (safe on upgrade).
# ============================================================
set -e

APP_DIR="/opt/lessan-ai"
VENV_DIR="$APP_DIR/.venv"
PW_BROWSERS="$APP_DIR/ms-playwright"
LOG="/var/log/lessan-ai-install.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

exec >>"$LOG" 2>&1

log "=== Lessan AI postinst ==="

# --- 1. Python venv --------------------------------------------
if [ ! -x "$VENV_DIR/bin/python" ]; then
    log "Creating virtualenv at $VENV_DIR ..."
    python3 -m venv "$VENV_DIR" || {
        log "ERROR: venv creation failed. Trying python3 -m venv --without-pip ..."
        python3 -m venv --without-pip "$VENV_DIR"
        curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py
        "$VENV_DIR/bin/python" /tmp/get-pip.py
        rm -f /tmp/get-pip.py
    }
fi

log "Installing Python requirements ..."
"$VENV_DIR/bin/pip" install --upgrade pip wheel setuptools
"$VENV_DIR/bin/pip" install -r "$APP_DIR/requirements.txt"

# --- 2. Playwright Chromium (durable browsers path) ------------
log "Installing Playwright Chromium browser ..."
if [ -n "$SUDO_USER" ]; then
    chown -R "$SUDO_USER":"$(id -gn "$SUDO_USER")" "$PW_BROWSERS" 2>/dev/null || true
fi
PLAYWRIGHT_BROWSERS_PATH="$PW_BROWSERS" "$VENV_DIR/bin/playwright" install chromium || {
    log "WARNING: Playwright browser install failed — Lessan browser/WhatsApp features may need 'playwright install' run manually."
}

# --- 3. Runtime state directory (created on first *launch*, not here) ---
# The data directory is owned by the desktop user and created by first_run.sh.
install -d -m 755 /opt/lessan-ai

log "=== Lessan AI postinst complete ==="

exit 0