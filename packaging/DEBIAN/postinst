#!/bin/bash
# ============================================================
#  postinst — Lessan AI .deb maintainer script
#  Runs as root after installation. Intentionally MINIMAL and
#  non-fatal: heavy setup (venv, pip, Playwright browsers)
#  happens lazily in the user's launcher at first run, where it
#  can be done without root and with full error reporting.
#  A maintainer script that fails here breaks apt/dpkg, so we
#  never exit non-zero for setup problems — only permission
#  normalization and desktop-database refresh run here.
# ============================================================
set -e

APP_DIR="/opt/lessan-ai"
LOG="/var/log/lessan-ai-install.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

exec >>"$LOG" 2>&1

log "=== Lessan AI postinst (v2) ==="

# --- 1. Ensure the shipped bundle is world-readable -------------
# Older .debs shipped files with mode 0600 baked in, which made the
# desktop user's rsync fail with "Permission denied" at launch.
# Re-normalize every install so that never happens again.
if [ -d "$APP_DIR" ]; then
    chmod -R a+rX "$APP_DIR" || log "WARNING: could not normalize perms on $APP_DIR"
fi

# --- 2. Remove stale root-owned venv/browsers placed by old
#         postinst scripts (1.0.0). The launcher now maintains a
#         per-user venv in ~/.local/share/lessan, so these root-owned
#         dirs are dead weight and could confuse the package. -----
rm -rf "$APP_DIR/.venv" "$APP_DIR/ms-playwright"
rm -f "$APP_DIR/.first_run_done"

# --- 3. Refresh desktop menu / icon caches ----------------------
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
fi

log "=== Lessan AI postinst complete ==="

exit 0