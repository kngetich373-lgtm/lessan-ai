# Lessan AI provider configuration
# Copy to .env and fill only the providers you actually use.

# OpenAI-compatible provider
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# Optional: local/OpenAI-compatible endpoint
LESSAN_MODEL_BASE_URL=
LESSAN_MODEL_API_KEY=
